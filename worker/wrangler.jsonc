/**
 * The Dalil Coach Worker (APP_BUILD_GUIDE.md section 11).
 * The model runs on Cloudflare Workers AI through the `AI` binding below, so there is no API key to keep.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dalil-coach",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-13",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	// Workers AI. `npm run dev` runs the model remotely on your Cloudflare account (you must be logged in).
	"ai": {
		"binding": "AI"
	},
	"vars": {
		// Comma-separated list of origins allowed to call /coach (CORS + origin check).
		// After the first Cloudflare Pages deploy, add its https://<name>.pages.dev address here.
		"ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173,https://dalil.msulaiman00711.workers.dev"
	}
}
